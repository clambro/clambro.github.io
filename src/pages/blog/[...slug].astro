---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { formatDate } from '../../utils/date';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };

const { post } = Astro.props as Props;
const { Content } = await render(post);
const displayDate = formatDate(post.data.publishedDate);
---

<Base
  title={post.data.title}
  description={post.data.subtitle}
  type="article"
  image={post.data.image}
  imageAlt={post.data.image_alt}
>
  <article class="post-page">
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <p class="subtitle">{post.data.subtitle}</p>
      <p class="date">
        <time datetime={post.data.publishedDate.toISOString()}>
          {displayDate}
        </time>
        <span class="post-tags">
          {post.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </span>
      </p>
      {post.data.image && (
        <div class="post-image">
          <Image
            src={post.data.image as ImageMetadata}
            alt={post.data.image_alt ?? ''}
            width={800}
            height={450}
            fit="contain"
          />
        </div>
      )}
    </header>
    <div class="post-content">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post-page {
    max-width: 900px;
    margin-inline: auto;
  }

  .post-header {
    margin-top: 3rem;
    margin-bottom: 2rem;
  }

  .subtitle {
    color: var(--muted);
    margin: 0.25rem 0 0.75rem 0;
  }

  .date {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .post-image {
    margin: 1.5rem 0 2rem 0;
    display: flex;
    justify-content: center;
  }

  .post-content :global(img) {
    max-width: 50%;
    height: auto;
    display: block;
    margin-inline: auto;
    cursor: zoom-in;
  }

  .post-content :global(.video-container) {
    max-width: 50%;
    margin: 2rem auto;
    aspect-ratio: 16 / 9;
  }

  .post-content :global(.video-container iframe) {
    width: 100%;
    height: 100%;
    border: none;
  }

  :global(.image-modal) {
    border: 0;
    padding: 0;
    max-width: 95vw;
    max-height: 95vh;
    background: transparent;
    cursor: zoom-out;
  }

  :global(.image-modal::backdrop) {
    background: rgba(0, 0, 0, 0.9);
  }

  :global(.image-modal img) {
    display: block;
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
  }

  .post-content :global(img[role='button']:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  @media (max-width: 768px) {
    .post-content :global(img) {
      max-width: 100%;
    }

    .post-content :global(.video-container) {
      max-width: 100%;
    }
  }
</style>

<script>
  const images =
    document.querySelectorAll<HTMLImageElement>('.post-content img');

  images.forEach((img) => {
    // Preserve links that deliberately wrap an image.
    if (img.closest('a')) return;
    img.tabIndex = 0;
    img.setAttribute('role', 'button');
    img.setAttribute('aria-haspopup', 'dialog');
    img.setAttribute(
      'aria-label',
      `Enlarge image: ${img.alt || 'Article image'}`
    );

    function openImage() {
      const modal = document.createElement('dialog');
      modal.className = 'image-modal';
      modal.setAttribute('aria-label', img.alt || 'Enlarged article image');
      const enlarged = document.createElement('img');
      enlarged.src = img.currentSrc || img.src;
      enlarged.alt = img.alt;
      modal.append(enlarged);
      modal.addEventListener('click', () => modal.close());
      modal.addEventListener(
        'close',
        () => {
          modal.remove();
          img.focus();
        },
        { once: true }
      );
      document.body.append(modal);
      modal.showModal();
    }

    img.addEventListener('click', openImage);
    img.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openImage();
      }
    });
  });
</script>
