---
import '../styles/global.css';
import { siteConfig } from '../config';
import PageMetadata from '../components/PageMetadata.astro';
---

<html lang="en">
  <head>
    <PageMetadata />
  </head>
  <body>
    <section class="hero">
      <h1>Costa Lambrinoudis</h1>
      <p class="muted">
        Started in physics, now building AI workflows and other cool things
      </p>
      <div class="main-buttons">
        <a class="button" href="/projects">
          Projects
        </a>
        <a class="button" href="/blog">
          Blog
        </a>
      </div>
      <div class="social-links">
        <a
          href={siteConfig.social.github}
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
          class="social-link"
        >
          <svg viewBox="0 0 24 24">
            <use href="/icons/github.svg#github"></use>
          </svg>
        </a>
        <a
          href={siteConfig.social.linkedin}
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn"
          class="social-link"
        >
          <svg viewBox="0 0 24 24">
            <use href="/icons/linkedin.svg#linkedin"></use>
          </svg>
        </a>
        <a
          href={siteConfig.social.twitter}
          target="_blank"
          rel="noopener"
          aria-label="X (Twitter)"
          class="social-link"
        >
          <svg viewBox="0 0 24 24">
            <use href="/icons/x.svg#x"></use>
          </svg>
        </a>
        <a
          href={siteConfig.social.rss}
          aria-label="RSS Feed"
          class="social-link"
          title="RSS feed"
        >
          <svg viewBox="0 0 24 24">
            <use href="/icons/rss.svg#rss"></use>
          </svg>
        </a>
      </div>
    </section>

    <div class="copyright">© {new Date().getFullYear()} Costa Lambrinoudis</div>

    <style>
      body {
        display: grid;
        grid-template-rows: 1fr auto 1fr;
        justify-items: center;
        align-items: center;
        gap: 1rem;
        height: auto;
        min-height: 100svh;
        padding: 1rem 0;
      }

      .hero {
        grid-row: 2;
        display: grid;
        border-radius: 18px;
        background: linear-gradient(180deg, #111317, #0d0f13);
        border: 1px solid #1e232b;
        text-align: center;
        justify-items: center;
        max-width: 800px;
        width: min(calc(100% - 2rem), clamp(400px, 50vw, 800px));
        padding: clamp(2rem, 4vw, 4rem);
      }

      .hero h1 {
        margin: 0;
        font-size: clamp(1.8rem, 4vw, 4rem);
      }

      .hero .main-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
        align-items: center;
        margin-bottom: 1.5rem;
      }

      .hero .social-links {
        display: flex;
        gap: 0.8rem;
        justify-content: center;
        align-items: center;
      }

      .button {
        display: inline-block;
        padding: clamp(0.6rem, 1.5vw, 1rem) clamp(1.2rem, 2.5vw, 2rem);
        border-radius: 10px;
        background: #1a2230;
        border: 1px solid #2a3445;
        color: var(--text);
        transition: all 0.2s ease;
        font-size: clamp(0.9rem, 1.2vw, 1.1rem);
        min-width: 120px;
        text-align: center;
      }

      .button:hover {
        background: #2a3445;
        text-decoration: none;
      }

      .muted {
        color: var(--muted);
        font-size: clamp(0.9rem, 1.5vw, 1.2rem);
      }

      .social-link {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.3rem;
        transition: opacity 0.2s ease;
      }

      .social-link:hover {
        text-decoration: none;
      }

      .social-link svg {
        width: 22px;
        height: 22px;
        fill: var(--muted);
        opacity: 0.8;
        transition: all 0.2s ease;
      }

      .social-link:hover svg {
        fill: var(--accent);
        opacity: 1;
        transform: scale(1.1);
      }

      .copyright {
        grid-row: 3;
        align-self: end;
        padding-inline: 1rem;
        text-align: center;
        color: var(--muted);
        font-size: 0.8rem;
      }
    </style>
  </body>
</html>
